# ==============================================================================
# CodeSentinel Environment Configuration Template
# Copy this file to .env and fill in required values for local development.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=CodeSentinel
APP_VERSION=0.1.0

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL - Planned for Phase 4)
POSTGRES_USER=codesentinel
POSTGRES_PASSWORD=codesentinel_dev_secret_change_me
POSTGRES_DB=codesentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://codesentinel:codesentinel_dev_secret_change_me@localhost:5432/codesentinel

# Cache & Message Broker (Redis - Planned for Phase 4)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery Worker (Planned for Phase 4)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI / LLM Providers (Planned for Phase 5)
# Supported options: openrouter, ollama
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Static Analysis Configuration
ANALYZER_TIMEOUT_SECONDS=300
MAX_UPLOAD_SIZE_MB=50
